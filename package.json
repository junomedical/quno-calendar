{
  "name": "@quno/calendar",
  "version": "0.6.0",
  "description": "Quno Infinite Calendar, Datepicker, Date Input, and headless Date Parser for React and Preact-compatible applications.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "calendar",
    "scheduler",
    "react",
    "virtualization",
    "timeline"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/shared/migration.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./infinite-calendar": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/infinite-calendar.js",
      "require": "./dist/infinite-calendar.cjs"
    },
    "./infinite-calendar/styles.css": "./dist/infinite-calendar.css",
    "./datepicker": {
      "types": "./dist/date-picker/index.d.ts",
      "import": "./dist/datepicker.js",
      "require": "./dist/datepicker.cjs"
    },
    "./datepicker/styles.css": "./dist/datepicker.css",
    "./date-input": {
      "types": "./dist/date-input/index.d.ts",
      "import": "./dist/date-input.js",
      "require": "./dist/date-input.cjs"
    },
    "./date-input/styles.css": "./dist/date-input.css",
    "./date-parser": {
      "types": "./dist/date-parser/index.d.ts",
      "import": "./dist/date-parser.js",
      "require": "./dist/date-parser.cjs"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build -c vite.lib.config.ts --mode shared && vite build -c vite.lib.config.ts --mode infinite-calendar && vite build -c vite.lib.config.ts --mode datepicker && vite build -c vite.lib.config.ts --mode date-input && vite build -c vite.lib.config.ts --mode date-parser",
    "build:demo": "vite build -c vite.config.ts --outDir dist-demo",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-demo-boundaries.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "report:size": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:compat": "node scripts/verify-preact-compat.mjs",
    "test:compat:react19": "node scripts/verify-react-19-compat.mjs",
    "verify:package": "npm run build:lib && npm run check:bundle-size && node scripts/verify-package.mjs",
    "preview": "vite preview --host 127.0.0.1 --outDir dist-demo"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12"
  },
  "peerDependencies": {
    "preact": ">=10.18.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "oxfmt": "^0.64.0",
    "preact": "^10.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.6"
  }
}
