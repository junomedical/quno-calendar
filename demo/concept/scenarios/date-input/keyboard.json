{
  "id": "keyboard",
  "label": "Edit with keyboard",
  "hint": "Step the day down, then move the month forward.",
  "anchor": "keyboard-controls",
  "initial": {
    "range": {
      "start": "2026-10-19",
      "end": "2026-10-19"
    },
    "selectionMode": "single",
    "picker": false,
    "label": "Appointment date"
  },
  "steps": [
    {
      "action": "wait",
      "ms": 650
    },
    {
      "action": "aim",
      "target": "[data-action=\"date-input\"]",
      "caption": "Place the caret in the day"
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowDown",
      "caret": 1
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowDown",
      "caret": 1
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowDown",
      "caret": 1
    },
    {
      "action": "wait",
      "ms": 750
    },
    {
      "action": "aim",
      "target": "[data-action=\"date-input\"]",
      "caption": "Place the caret in the month"
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowUp",
      "caret": 4
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowUp",
      "caret": 4
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "ArrowUp",
      "caret": 4
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "key",
      "target": "[data-action=\"date-input\"]",
      "key": "Enter"
    },
    {
      "action": "wait",
      "ms": 1700
    }
  ],
  "paragraphs": [
    "Place the caret in a day, month or year and use the up and down arrows to change that part of the date. The field keeps ordinary text selection and keyboard editing.",
    "The edits follow the calendar: stepping back from the first day of a month takes you into the previous month, rather than leaving you with an impossible date."
  ]
}
