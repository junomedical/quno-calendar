{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"],
    "paths": {
      "@quno/calendar": ["./src/lib/index.ts"],
      "@quno/calendar/infinite-calendar": ["./src/lib/timeline/index.ts"],
      "@quno/calendar/datepicker": ["./src/lib/date-picker/index.ts"],
      "@quno/calendar/booking-picker": ["./src/lib/booking-picker/index.ts"],
      "@quno/calendar/date-input": ["./src/lib/date-input/index.ts"],
      "@quno/calendar/date-parser": ["./src/lib/date-parser/index.ts"],
      "#quno-internal/*": ["./src/lib/*"],
      "#quno-demo/*": ["./demo/*"],
      "#quno-api/*": ["./api/*"],
      "#quno-e2e/*": ["./e2e/*"],
      "#quno-tests/*": ["./tests/*"],
      "#quno-project/*": ["./*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "api",
    "src",
    "demo",
    "tests",
    "e2e",
    "vite",
    "vite.config.ts",
    "vite.lib.config.ts",
    "playwright.config.ts"
  ]
}
